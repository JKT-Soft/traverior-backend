    {
      "name": "Trips (Journey)",
      "description": "Requires auth + PostgreSQL. Create Trip first — test script saves tripId and rootNodeId.",
      "item": [
        {
          "name": "GET /v1/trips",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/trips"
          }
        },
        {
          "name": "POST /v1/trips",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.ok && json.data && json.data.trip) {",
                  "  const trip = json.data.trip;",
                  "  pm.collectionVariables.set('tripId', trip.id);",
                  "  if (trip.rootNodeId) pm.collectionVariables.set('rootNodeId', trip.rootNodeId);",
                  "  if (trip.rootNodeId) pm.collectionVariables.set('parentId', trip.rootNodeId);",
                  "  console.log('Saved tripId=', trip.id, 'rootNodeId=', trip.rootNodeId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Japan 2026\",\n  \"originCity\": \"Jakarta\",\n  \"destinationSummary\": \"Osaka · Kyoto\",\n  \"startDate\": \"2026-10-01\",\n  \"endDate\": \"2026-10-08\",\n  \"partySize\": 2\n}"
            },
            "url": "{{baseUrl}}/v1/trips",
            "description": "Creates trip + root JOURNEY node. Saves {{tripId}} and {{rootNodeId}}."
          }
        },
        {
          "name": "GET /v1/trips/:tripId",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/trips/{{tripId}}"
          }
        },
        {
          "name": "GET /v1/trips/:tripId/nodes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/trips/{{tripId}}/nodes?parentId={{parentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "trips",
                "{{tripId}}",
                "nodes"
              ],
              "query": [
                {
                  "key": "parentId",
                  "value": "{{parentId}}",
                  "description": "Omit or empty to list root children"
                }
              ]
            }
          }
        },
        {
          "name": "GET /v1/trips/:tripId/nodes (root children)",
