{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-traverior0001",
    "name": "Traverior API",
    "description": "HTTP collection for Traverior modular monolith (Fastify).\n\nAuth: `Authorization: Bearer {{authToken}}` — Firebase ID token from Google Sign-In.\nOnly GET /health is public.\n\nResponse envelope:\n- success: `{ ok: true, data }`\n- error: `{ ok: false, error: { code, message } }`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "authToken",
      "value": "<firebase-id-token>"
    },
    {
      "key": "tripId",
      "value": ""
    },
    {
      "key": "rootNodeId",
      "value": ""
    },
    {
      "key": "parentId",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Service health + active providers."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get Firebase ID token (email/password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code === 200 && json.idToken) {",
                  "  pm.environment.set('authToken', json.idToken);",
                  "  console.log('authToken saved (' + json.email + ')');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"returnSecureToken\": true\n}"
            },
            "url": {
              "raw": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{firebaseWebApiKey}}",
              "protocol": "https",
              "host": ["identitytoolkit", "googleapis", "com"],
              "path": ["v1", "accounts:signInWithPassword"],
              "query": [{ "key": "key", "value": "{{firebaseWebApiKey}}" }]
            },
            "description": "Jangan kirim Authorization header. Hanya Web API key di query.\nAuth tab request ini HARUS No Auth (collection Traverior memakai Bearer).\nSukses: simpan idToken ke environment authToken otomatis."
          }
        },
        {
          "name": "GET /v1/auth/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/auth/health"
          }
        },
        {
          "name": "GET /v1/auth/me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/auth/me",
            "description": "Requires Firebase ID token (Google Sign-In)."
          }
        }
      ]
