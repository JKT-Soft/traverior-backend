            },
            "url": "{{baseUrl}}/v1/trips/{{tripId}}/nodes",
            "description": "parentId must be UUID of existing node (use {{rootNodeId}} from Create Trip). type: CHECKPOINT | LEG | ACTIVITY | POI | BOOKING | MODULE | LEAF"
          }
        }
