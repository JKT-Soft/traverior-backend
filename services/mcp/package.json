{
  "name": "@traverior/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Traverior MCP servers (per-domain tool connectors)",
  "type": "module",
  "scripts": {
    "flights": "tsx src/flights/main.ts",
    "hotels": "tsx src/hotels/main.ts",
    "places": "tsx src/places/main.ts",
    "routes": "tsx src/routes/main.ts",
    "weather": "tsx src/weather/main.ts",
    "events": "tsx src/events/main.ts",
    "visa": "tsx src/visa/main.ts",
    "checklist": "tsx src/checklist/main.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs src --tsx",
    "test:watch": "node scripts/run-tests.mjs src --tsx --watch",
    "test:coverage": "c8 -- node scripts/run-tests.mjs src --tsx"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "c8": "^10.1.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
