# Server
PORT=3000
NODE_ENV=development
AUTH_MODE=firebase
# AUTH_MODE=firebase  → verify Firebase ID tokens (Google Sign-In on mobile)
# AUTH_MODE=dev       → accept Bearer dev:<firebaseUid> for local testing without Firebase

# Logging (JSON lines → files + console)
LOG_DIR=logs
LOG_LEVEL=info

# Redis cache for third-party provider responses
CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379
CACHE_TTL_FLIGHTS=900
CACHE_TTL_HOTELS=900
CACHE_TTL_PLACES=86400
CACHE_TTL_ROUTES=3600
CACHE_TTL_WEATHER=1800
CACHE_TTL_EVENTS=1800
CACHE_TTL_VISA=604800
CACHE_TTL_TRIPS=60
CACHE_TTL_IMAGES=604800

DATABASE_URL=postgresql://traverior:traverior@localhost:5432/traverior?schema=public

# Firebase (required when AUTH_MODE=firebase)
# Project ID from Firebase Console → Project settings.
# Optional: path to service account JSON (Admin SDK). verifyIdToken works with project ID alone.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# LLM (Planner Fase 1 — skeleton)
# Auto: openai if OPENAI_API_KEY set, else heuristic
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# MCP client (Planner Fase 2)
# inprocess = call domain services directly (recommended for Docker / production)
# stdio = spawn services/mcp/* server processes (local dev; needs tsx + MCP sources)
MCP_MODE=inprocess
# MCP_SERVERS_DIR=../mcp
# MCP_RUNNER_COMMAND=node
# MCP_RUNNER_ARGS=/path/to/tsx/cli
# MCP_ALLOW_STDIO_IN_PRODUCTION=true
# ANTHROPIC_API_KEY=

# Provider selection (swap without rewriting domain code)
# Values: mock | duffel | liteapi | google | openweather | eventbrite | viator | composite | sherpa | static | unsplash
# Live providers on (except Sherpa + Viator)
PROVIDER_FLIGHTS=duffel
PROVIDER_HOTELS=liteapi
PROVIDER_PLACES=google
PROVIDER_ROUTES=google
PROVIDER_WEATHER=openweather
# eventbrite only — Viator off
PROVIDER_EVENTS=eventbrite
# static curated visa — Sherpa off
PROVIDER_VISA=static
# location images — unsplash requires UNSPLASH_ACCESS_KEY
PROVIDER_IMAGES=mock
# PROVIDER_IMAGES=unsplash

# Provider credentials (used when not mock)
DUFFEL_ACCESS_TOKEN=
LITEAPI_KEY=
GOOGLE_MAPS_API_KEY=
OPENWEATHER_API_KEY=
EVENTBRITE_TOKEN=
# Leave empty while PROVIDER_EVENTS=eventbrite
VIATOR_API_KEY=
SHERPA_API_KEY=
EXCHANGERATE_API_KEY=
# https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=
